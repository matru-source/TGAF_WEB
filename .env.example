# ----------------------------------------------------------------------------
# Goodearth Foods - environment variables
# Copy this file to ".env" and fill in real values.
# ----------------------------------------------------------------------------

# NeonDB (PostgreSQL) connection string.
# In the Neon dashboard, copy the "Pooled connection" string.
# It looks like:
#   postgresql://USER:PASSWORD@ep-xxxx-pooler.REGION.aws.neon.tech/DBNAME?sslmode=require
DATABASE_URL="postgresql://user:password@ep-example-pooler.us-east-2.aws.neon.tech/neondb?sslmode=require"

# Secret used to sign admin session JWTs. Use a long random string in production.
# Generate one with:  node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET="change-me-to-a-long-random-string"

# Admin account created by the seed script (prisma/seed.ts).
ADMIN_EMAIL="admin@goodearthfoods.com"
ADMIN_PASSWORD="ChangeMe!2026"
